{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{*.php,api/*.php,config/*.php,includes/*.php,assets/**}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler.php?action=run_morning_queue",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/scheduler.php?action=run_evening_queue",
      "schedule": "0 14 * * *"
    }
  ]
}
